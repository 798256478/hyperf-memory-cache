{
    "name": "groupbuy/hyperf-memory-cache",
    "description": "Hyperf Swoole Table based local L1 memory cache with annotation-driven AOP, single-flight and TTL jitter",
    "type": "library",
    "keywords": ["hyperf", "swoole", "memory-cache", "local-cache", "aop", "single-flight"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "hyperf/di": "~3.1.0",
        "hyperf/memory": "~3.1.0",
        "hyperf/logger": "~3.1.0",
        "hyperf/contract": "~3.1.0",
        "hyperf/engine": "^2.10",
        "hyperf/framework": "~3.1.0",
        "ext-swoole": ">=5.0"
    },
    "suggest": {
        "hyperf/command": "Needed for memory-cache:stats command",
        "ext-igbinary": "Faster serialization when available"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Groupbuy\\HyperfMemoryCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Groupbuy\\HyperfMemoryCache\\Tests\\": "tests/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Groupbuy\\HyperfMemoryCache\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    }
}
